{
	"appId": "money.arkade.app",
	"appName": "Arkade Wallet",
	"webDir": "dist",
	"server": {
		"androidScheme": "https"
	},
	"plugins": {
		"Keyboard": {
			"resize": "native",
			"resizeOnFullScreen": true
		},
		"SplashScreen": {
			"launchAutoHide": true,
			"launchShowDuration": 500,
			"backgroundColor": "#101010",
			"androidScaleType": "CENTER_CROP"
		}
	}
}
